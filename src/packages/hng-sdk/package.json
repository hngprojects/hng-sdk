{
  "name": "hng-sdk",
  "version": "0.0.0",
  "description": "HNG SDK - Monorepo base package",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "test": "echo 'No tests yet'; exit 0",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hng-sdk/email": "workspace:*",
    "@hng-sdk/ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "keywords": [
    "hng",
    "sdk",
    "toolkit"
  ],
  "license": "ISC"
}
