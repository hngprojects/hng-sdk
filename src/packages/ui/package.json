{
  "name": "@hng-sdk/ui",
  "version": "0.0.0",
  "description": "UI component library for HNG SDK",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./globals.css": "./src/global.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && pnpm build:css",
    "dev": "tsc --watch",
    "build:css": "echo 'CSS build placeholder'",
    "test": "echo 'No tests yet'; exit 0",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "hng",
    "sdk"
  ],
  "license": "ISC",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0"
  }
}
