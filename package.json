{
  "name": "hng-sdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HNG SDK Monorepo - Collection of utilities and tools",
  "scripts": {
    "build": "pnpm -r --filter './src/packages/**' run build",
    "dev": "pnpm -r --filter './src/packages/**' run dev",
    "clean": "pnpm -r --filter './src/packages/**' run clean",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky"
  },
  "keywords": [
    "hng",
    "sdk",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.2",
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx,json,md,yml,yaml}": "prettier --write"
  }
}
